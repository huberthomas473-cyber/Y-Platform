# ── Client (exposed to the browser — safe by design, protected by Supabase RLS) ──
# From your Supabase project: Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Server only (used by /api/deliberate — NEVER exposed to the browser) ──
# Anthropic API key for the Deliberate AI facilitator: https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-...

# Same Supabase project, but the service-role key so the server can persist
# deliberation messages privately (no public read access to chats).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
